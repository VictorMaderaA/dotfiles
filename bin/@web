#!/usr/bin/env bash
# Lanzador de utilidades web del sistema de dotfiles

WEB_DIR="$(cd "$(dirname "$0")" && pwd)/web"

# Colores para la terminal
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

get_tools() {
    # Listar archivos .html directos
    find "$WEB_DIR" -maxdepth 1 -name "*.html" -not -name "index.html" -printf "%f\n" | sed 's/\.html//'
    
    # Listar directorios que contienen index.html
    find "$WEB_DIR" -maxdepth 2 -name "index.html" | while read -r line; do
        echo "$(basename "$(dirname "$line")")"
    done | sort | uniq
}

list_tools() {
    echo -e "${BLUE}Utilidades Web Disponibles:${NC}"
    get_tools | sed 's/^/  - /'
}

open_tool() {
    local tool=$1
    local target=""

    if [[ -f "$WEB_DIR/$tool.html" ]]; then
        target="$WEB_DIR/$tool.html"
    elif [[ -f "$WEB_DIR/$tool/index.html" ]]; then
        target="$WEB_DIR/$tool/index.html"
    fi

    if [[ -n "$target" ]]; then
        echo -e "${GREEN}Abriendo $tool...${NC}"
        # Detectar el comando para abrir el navegador
        if command -v xdg-open &> /dev/null; then
            xdg-open "$target"
        elif command -v open &> /dev/null; then
            open "$target"
        else
            echo "No se pudo encontrar un comando para abrir el navegador (xdg-open u open)."
            echo "Ruta del archivo: $target"
        fi
    else
        echo "Error: Utilidad '$tool' no encontrada."
        list_tools
    fi
}

if [[ $# -eq 0 ]]; then
    if command -v fzf &> /dev/null; then
        SELECTED=$(get_tools | fzf --height 40% --layout=reverse --border --prompt="Selecciona utilidad web: ")
        if [[ -n "$SELECTED" ]]; then
            open_tool "$SELECTED"
        fi
    else
        list_tools
    fi
else
    open_tool "$1"
fi
