# Archivo de ejemplo para variables de entorno personalizadas
# Copia este archivo como 'env.local' en este mismo directorio
# o como '~/.env.local' en tu home para que sea cargado automáticamente.
# Este archivo es ignorado por git para proteger tus secretos.

# Ejemplos de variables de herramientas externas:
# export OPENAI_API_KEY="tu_clave_aqui"
# export HF_TOKEN="tu_token_hugging_face"
# export AWS_ACCESS_KEY_ID="tu_id_de_acceso"
# export AWS_SECRET_ACCESS_KEY="tu_clave_secreta"
# export GITHUB_TOKEN="tu_token_personal"

# Variables de entorno para el proyecto
# export MY_PROJECT_PATH="$HOME/projects/my-project"

export SYNCFUSION_API_KEY=""
export OPENAI_API_KEY=""
