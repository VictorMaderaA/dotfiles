# Terminal defaults shared by bash, zsh and login shells.
#
# Why this file exists:
# - Keep locale and terminal fallbacks consistent across all devices.
# - Avoid duplicating the same exports in .bashrc, .zshrc and .profile.
# - Let per-host or per-user overrides still win when they are already set.
#
# The values are only applied when the variable is currently empty, so an
# existing remote setup or a local override in ~/.env.local can replace them.

# Locale defaults for SSH sessions and remote shells.
#
# Prefer Spanish when the system actually has that locale generated. Otherwise
# fall back to a broadly available UTF-8 locale so tools like `man` do not emit
# warnings about invalid LC_* values.
if [ -z "${LANG:-}" ]; then
    if locale -a 2>/dev/null | grep -qiE '^(es_ES\.utf8|es_ES\.UTF-8)$'; then
        export LANG=es_ES.UTF-8
    elif locale -a 2>/dev/null | grep -qiE '^(en_US\.utf8|en_US\.UTF-8|C\.UTF-8)$'; then
        export LANG=en_US.UTF-8
    else
        export LANG=C.UTF-8
    fi
fi

# Avoid forcing an unsupported LC_ALL. Leave it unset unless the caller already
# provided one, because LC_ALL overrides LANG and is the usual source of this
# warning when a locale is missing from the system.
if [ -n "${LC_ALL:-}" ]; then
    export LC_ALL
fi

# Fallback terminal type for shells started outside tmux or without a sane TERM.
# Do not overwrite an existing TERM because tmux, Kitty, WezTerm or VS Code
# Remote SSH may already negotiate a better value.
if [ -z "${TERM:-}" ] || [ "$TERM" = "dumb" ]; then
    export TERM=xterm-256color
fi
